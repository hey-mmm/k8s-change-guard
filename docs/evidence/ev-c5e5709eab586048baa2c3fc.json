  "ai": {
    "status": "ok",
    "model": "deepseek-chat",
    "summary": "Release 823770eff4e9 replaces the demo Deployment image digest and bumps the app.kubernetes.io/version label on Deployment, Service, and ServiceMonitor, plus redacted env value changes in the pod template. Decision preview is REVIEW. Two findings warrant attention: 35 unreserved pod requests may overstate free capacity, and KubeCPUOvercommit is firing (NodeSystemSaturation pending). Capacity shows 2190m CPU / ~9.2GB memory available on 1 ready worker, so a maxSurge:1 rollout should fit, but the unreserved-request caveat means headroom is uncertain. Because the pod template changes, verify the new Pod reaches Ready and serves the new version; old-Pod readiness or Service 200s alone do not prove the new version is live. If the rollout fails, roll back via a Git revert commit and Argo resync, not an imperative undo.",
    "additional_risks": [
      {
        "title": "New-version verification must target the new Pod",
        "detail": "The image digest and env values change in the pod template, so a successful rollout must be confirmed against the new Pod's readiness and version, not the retained old Pod or Service responses.",
        "severity": "REVIEW"
      },
      {
        "title": "Capacity headroom is uncertain under a firing overcommit alert",
        "detail": "KubeCPUOvercommit is firing and 35 scheduled Pods lack CPU/memory requests, so reported free capacity may be overstated; the surge Pod for this rollout may not fit as assumed.",
        "severity": "REVIEW"
      },
      {
        "title": "Rollback must change Git desired state",
        "detail": "If this release misbehaves, recovery requires a revert commit pushed to main and an Argo resync with revision/image/version verification; an imperative rollback alone does not constitute a GitOps rollback.",
        "severity": "REVIEW"
      }
    ],

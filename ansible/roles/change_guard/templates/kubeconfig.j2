apiVersion: v1
kind: Config
clusters:
  - name: change-guard
    cluster:
      server: {{ change_guard_bootstrap_json.clusters[0].cluster.server | to_json }}
      certificate-authority-data: {{ change_guard_bootstrap_json.clusters[0].cluster['certificate-authority-data'] | to_json }}
users:
  - name: change-guard
    user:
      token: {{ change_guard_token_request.stdout | trim | to_json }}
contexts:
  - name: change-guard
    context:
      cluster: change-guard
      user: change-guard
      namespace: {{ change_guard_namespace }}
current-context: change-guard

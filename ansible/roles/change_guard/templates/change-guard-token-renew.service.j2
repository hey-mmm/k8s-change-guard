[Unit]
Description=Renew fixed read-only change-guard Kubernetes identity
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart={{ change_guard_binary }} renew-token
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths={{ change_guard_root }}
ReadWritePaths={{ change_guard_config_dir }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=45
